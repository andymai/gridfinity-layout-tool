pnpm exec lint-staged
pnpm run check:boundaries:staged
pnpm run check:design-system:staged
pnpm run check:i18n
pnpm run check:i18n:values
pnpm run check:i18n:interpolation
# check:i18n:unused scans all source files — only run when i18n files are staged
if git diff --cached --name-only | grep -qE '^src/i18n/'; then
  pnpm run check:i18n:unused
fi
pnpm run check:exhaustiveness
# pnpm run test:affected  # disabled — too slow for pre-commit, run manually or in CI
pnpm run check:component-structure
pnpm run check:missing-tests
pnpm run check:readme-reminders
pnpm run check:whats-new
# User docs: every UI label, source path, sidebar entry and app link must
# resolve. A renamed i18n key or a moved source file breaks a docs page, so
# en.ts and the content routes trigger the check as well as the docs.
if git diff --cached --name-only | grep -qE '^(apps/docs/|src/i18n/locales/en\.ts$|scripts/contentRoutes\.ts$|scripts/check-user-docs)'; then
  pnpm run check:user-docs
fi
# Warns only: names docs pages whose listed sources are in this commit.
pnpm run check:user-docs:staged
# Docs drift two ways: refs to deleted code, and unbounded growth. Only run
# when a doc is actually staged — it walks every tracked file.
if git diff --cached --name-only | grep -qE '\.md$'; then
  pnpm run check:doc-drift
  # A doc that shrank ratchets its baseline down as a side effect, so re-stage
  # it rather than leaving the commit with a dirty tree behind it.
  git add scripts/doc-budget.json
fi
