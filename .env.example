# Posthog Analytics (optional - analytics disabled if not set)
# API calls are proxied through Vercel (/ph) to avoid ad blockers
VITE_PUBLIC_POSTHOG_KEY=phc_your_key_here

# Liveblocks (required for collaborative editing feature)
# Public API key from https://liveblocks.io/dashboard
VITE_LIVEBLOCKS_PUBLIC_KEY=pk_your_key_here

# Multi-device sync — OAuth providers (required for sign-in)
# See api/auth/README.md for provider setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Base URL the OAuth providers redirect back to (e.g. https://example.com).
# Must match the redirect URIs configured on each provider's console.
# Leave blank in dev — falls back to Vercel's auto-detected URL.
OAUTH_REDIRECT_BASE_URL=
